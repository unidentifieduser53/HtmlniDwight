# ---------------- Order Product ----------------
def order_product():
    con = None
    cur = None

    try:
        refresh_products()

        id_str = entry_id.get().strip()
        qty_str = entry_qty.get().strip()

        if id_str == "" or not id_str.isdigit():
            raise ValueError(
                "Please enter a valid Product ID to order."
            )

        if qty_str == "" or not qty_str.isdigit() or int(qty_str) <= 0:
            raise ValueError(
                "Please enter a valid Quantity to order."
            )

        product_id = int(id_str)
        order_qty = int(qty_str)

        con = mysql.connector.connect(
            host="localhost",
            database="db_jollibee",
            user="root",
            password=""
        )

        cur = con.cursor()

        cur.execute(
            """
            SELECT PRODUCT_NAME, PRODUCT_PRICE, PRODUCT_QUANTITY
            FROM tbl_product
            WHERE PRODUCT_ID = %s
            """,
            (product_id,)
        )

        record = cur.fetchone()

        if record is None:
            raise ValueError(
                "No product found with that ID."
            )

        prod_name, prod_price, prod_stock = record

        if order_qty > prod_stock:
            raise ValueError(
                f"Only {prod_stock} in stock."
            )

        total = prod_price * order_qty

        if messagebox.askyesno(
            "Confirm Order",
            f"Order {order_qty}x {prod_name} for a total of P{total:.2f}?"
        ):
            cur.execute(
                """
                INSERT INTO tbl_order
                (PRODUCT_ID, PRODUCT_NAME, QUANTITY, TOTAL_PRICE)
                VALUES (%s, %s, %s, %s)
                """,
                (product_id, prod_name, order_qty, total)
            )

            cur.execute(
                """
                UPDATE tbl_product
                SET PRODUCT_QUANTITY = PRODUCT_QUANTITY - %s
                WHERE PRODUCT_ID = %s
                """,
                (order_qty, product_id)
            )

            con.commit()

            messagebox.showinfo(
                "Success",
                "Order successfully placed!"
            )

            entry_id.delete(0, tkinter.END)
            entry_qty.delete(0, tkinter.END)

    except ValueError as error:
        messagebox.showerror("Error", str(error))

    except Error as error:
        messagebox.showerror("Database Error", str(error))

    finally:
        if cur is not None:
            cur.close()

        if con is not None:
            con.close()

        refresh_products()


