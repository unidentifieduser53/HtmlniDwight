*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial, Helvetica, sans-serif;
}

body{
background:#f9f3eb;
color:#3e2723;
}

header{
background:#8d5524;
color:white;
padding:30px;
text-align:center;
}

nav{
background:#d2691e;
display:flex;
justify-content:center;
flex-wrap:wrap;
}

nav a{
color:white;
padding:15px 20px;
text-decoration:none;
font-weight:bold;
}

nav a:hover{
background:#8d5524;
}

.hero{
padding:80px;
text-align:center;
background:linear-gradient(rgba(0,0,0,.4),rgba(0,0,0,.4)),
url(images/marilao.jpg);
background-size:cover;
background-position:center;
color:white;
}

.container{
width:90%;
margin:30px auto;
display:grid;
grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
gap:20px;
}

.card{
background:white;
padding:20px;
border-radius:10px;
box-shadow:0 0 10px rgba(0,0,0,.2);
}

.card h2,
.card h3{
color:#c65d00;
margin-bottom:10px;
}

.card ul{
margin-left:20px;
}

input,
select,
textarea{
width:100%;
padding:10px;
margin:10px 0;
border:1px solid #ccc;
border-radius:5px;
}

button{
background:#d2691e;
color:white;
padding:12px;
border:none;
width:100%;
cursor:pointer;
border-radius:5px;
font-size:16px;
}

button:hover{
background:#8d5524;
}

footer{
background:#8d5524;
color:white;
text-align:center;
padding:20px;
margin-top:30px;
}

@media(max-width:768px){

.hero{
padding:50px 20px;
}

nav{
flex-direction:column;
}

nav a{
text-align:center;
border-top:1px solid rgba(255,255,255,.2);
}

.container{
grid-template-columns:1fr;
}

}
