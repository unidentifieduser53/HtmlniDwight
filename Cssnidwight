# FUNCTIONS
# ============================================================

# ---------------- View All Products ----------------
def refresh_products():
    con = None
    cur = None

    try:
        for row in tree.get_children():
            tree.delete(row)

        con = mysql.connector.connect(
            host="localhost",
            database="db_jollibee",
            user="root",
            password=""
        )

        cur = con.cursor()

        cur.execute("""
            SELECT PRODUCT_ID, PRODUCT_NAME, PRODUCT_PRICE, PRODUCT_QUANTITY
            FROM tbl_product
        """)

        for r in cur.fetchall():
            tree.insert(
                "",
                tkinter.END,
                values=(r[0], r[1], f"P{r[2]:.2f}", r[3])
            )

    except Error as error:
        messagebox.showerror("Database Error", str(error))

    finally:
        if cur is not None:
            cur.close()

        if con is not None:
            con.close()


# ---------------- Add Product ----------------
def add_product():
    con = None
    cur = None

    try:
        name = entry_name.get().strip()
        price_str = entry_price.get().strip()
        qty_str = entry_qty.get().strip()

        if name == "" or price_str == "" or qty_str == "":
            raise ValueError(
                "Product Name, Price, and Quantity are required."
            )

        price = float(price_str)
        qty = int(qty_str)

        if price <= 0 or qty <= 0:
            raise ValueError(
                "Price and Quantity must be greater than 0."
            )

        con = mysql.connector.connect(
            host="localhost",
            database="db_jollibee",
            user="root",
            password=""
        )

        cur = con.cursor()

        cur.execute(
            """
            INSERT INTO tbl_product
            (PRODUCT_NAME, PRODUCT_PRICE, PRODUCT_QUANTITY)
            VALUES (%s, %s, %s)
            """,
            (name, price, qty)
        )

        con.commit()

        messagebox.showinfo(
            "Success",
            f"'{name}' successfully added!"
        )

        entry_id.delete(0, tkinter.END)
        entry_name.delete(0, tkinter.END)
        entry_price.delete(0, tkinter.END)
        entry_qty.delete(0, tkinter.END)

    except ValueError as error:
        messagebox.showerror("Error", str(error))

    except Error as error:
        messagebox.showerror("Database Error", str(error))

    finally:
        if cur is not None:
            cur.close()

        if con is not None:
            con.close()

        refresh_products()


# ---------------- Delete Product ----------------
def delete_product():
    con = None
    cur = None

    try:
        id_str = entry_id.get().strip()

        if id_str == "" or not id_str.isdigit():
            raise ValueError(
                "Please enter a valid Product ID to delete."
            )

        product_id = int(id_str)

        con = mysql.connector.connect(
            host="localhost",
            database="db_jollibee",
            user="root",
            password=""
        )

        cur = con.cursor()

        cur.execute(
            "SELECT PRODUCT_NAME FROM tbl_product WHERE PRODUCT_ID = %s",
            (product_id,)
        )

        record = cur.fetchone()

        if record is None:
            raise ValueError(
                "No product found with that ID."
            )

        if messagebox.askyesno(
            "Confirm",
            f"Delete '{record[0]}'?"
        ):
            cur.execute(
                "DELETE FROM tbl_product WHERE PRODUCT_ID = %s",
                (product_id,)
            )

            con.commit()

            messagebox.showinfo(
                "Success",
                "Product successfully deleted!"
            )

            entry_id.delete(0, tkinter.END)

    except ValueError as error:
        messagebox.showerror("Error", str(error))

    except Error as error:
        messagebox.showerror("Database Error", str(error))

    finally:
        if cur is not None:
            cur.close()

        if con is not None:
            con.close()

        refresh_products()


# ---------------- Update Product ----------------
