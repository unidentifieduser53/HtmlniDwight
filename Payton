import mysql.connector
from mysql.connector import Error

# Expected table schema:
# CREATE TABLE tbl_product (
#     PRODUCT_ID INT AUTO_INCREMENT PRIMARY KEY,
#     PRODUCT_NAME VARCHAR(100),
#     PRODUCT_PRICE DECIMAL(10,2),
#     PRODUCT_QUANTITY INT
# );
#
# CREATE TABLE tbl_order (
#     ORDER_ID INT AUTO_INCREMENT PRIMARY KEY,
#     PRODUCT_ID INT,
#     PRODUCT_NAME VARCHAR(100),
#     QUANTITY INT,
#     TOTAL_PRICE DECIMAL(10,2),
#     FOREIGN KEY (PRODUCT_ID) REFERENCES tbl_product(PRODUCT_ID)
# );

while True:
    print("\n===== JOLLIBEE PRODUCT SYSTEM =====")
    print("1. Add a product")
    print("2. Update a product")
    print("3. Delete a product")
    print("4. Display all products")
    print("5. Place an order")
    print("6. Display all orders")
    print("7. Exit")

    try:
        choice = int(input("Enter your choice (1-7): ").strip())
    except ValueError:
        print("Error: Invalid input. Please enter a number.")
        continue

    # ---------------- ADD ----------------
    if choice == 1:
        print("\n--- Add Jollibee Product ---")

        name = ""
        while name == "":
            name = input("Product Name: ").strip()
            if name == "":
                print("Error: This field cannot be empty. Please try again.")

        price = None
        while price is None:
            try:
                price = float(input("Product Price: ").strip())
                if price <= 0:
                    print("Error: Price must be greater than 0.")
                    price = None
            except ValueError:
                print("Error: Please enter a valid number.")

        quantity = None
        while quantity is None:
            try:
                quantity = int(input("Product Quantity: ").strip())
                if quantity <= 0:
                    print("Error: Quantity must be greater than 0.")
                    quantity = None
            except ValueError:
                print("Error: Please enter a valid whole number.")

        try:
            con = mysql.connector.connect(host="localhost", database="db_jollibee", user="root", password="")
            cur = con.cursor()
            query = "INSERT INTO tbl_product (PRODUCT_NAME, PRODUCT_PRICE, PRODUCT_QUANTITY) VALUES (%s, %s, %s)"
            cur.execute(query, (name, price, quantity))
            con.commit()
            print(f"'{name}' successfully added!")
            cur.close()
            con.close()
        except Error as error:
            print(f"Error adding product: {error}")

    # ---------------- UPDATE ----------------
    elif choice == 2:
        print("\n--- Update Jollibee Product ---")

        product_id = None
        while product_id is None:
            try:
                product_id = int(input("Enter Product ID to update: ").strip())
            except ValueError:
                print("Error: Please enter a valid whole number.")

        try:
            con = mysql.connector.connect(host="localhost", database="db_jollibee", user="root", password="")
            cur = con.cursor()
            cur.execute("SELECT * FROM tbl_product WHERE PRODUCT_ID = %s", (product_id,))
            record = cur.fetchone()

            if record is None:
                print("Error: No product found with that ID.")
            else:
                name = ""
                while name == "":
                    name = input("New Product Name: ").strip()
                    if name == "":
                        print("Error: This field cannot be empty. Please try again.")

                price = None
                while price is None:
                    try:
                        price = float(input("New Product Price: ").strip())
                        if price <= 0:
                            print("Error: Price must be greater than 0.")
                            price = None
                    except ValueError:
                        print("Error: Please enter a valid number.")

                quantity = None
                while quantity is None:
                    try:
                        quantity = int(input("New Product Quantity: ").strip())
                        if quantity <= 0:
                            print("Error: Quantity must be greater than 0.")
                            quantity = None
                    except ValueError:
                        print("Error: Please enter a valid whole number.")

                query = "UPDATE tbl_product SET PRODUCT_NAME=%s, PRODUCT_PRICE=%s, PRODUCT_QUANTITY=%s WHERE PRODUCT_ID=%s"
                cur.execute(query, (name, price, quantity, product_id))
                con.commit()
                print("Product successfully updated!")

            cur.close()
            con.close()
        except Error as error:
            print(f"Error updating product: {error}")

    # ---------------- DELETE ----------------
    elif choice == 3:
        print("\n--- Delete Jollibee Product ---")

        product_id = None
        while product_id is None:
            try:
                product_id = int(input("Enter Product ID to delete: ").strip())
            except ValueError:
                print("Error: Please enter a valid whole number.")

        try:
            con = mysql.connector.connect(host="localhost", database="db_jollibee", user="root", password="")
            cur = con.cursor()
            cur.execute("SELECT * FROM tbl_product WHERE PRODUCT_ID = %s", (product_id,))
            record = cur.fetchone()

            if record is None:
                print("Error: No product found with that ID.")
            else:
                confirm = input(f"Are you sure you want to delete product ID {product_id}? (y/n): ").strip().lower()
                if confirm == "y":
                    cur.execute("DELETE FROM tbl_product WHERE PRODUCT_ID = %s", (product_id,))
                    con.commit()
                    print("Product successfully deleted!")
                else:
                    print("Delete cancelled.")

            cur.close()
            con.close()
        except Error as error:
            print(f"Error deleting product: {error}")

    # ---------------- DISPLAY PRODUCTS ----------------
    elif choice == 4:
        print("\n--- Jollibee Product Menu ---")
        try:
            con = mysql.connector.connect(host="localhost", database="db_jollibee", user="root", password="")
            cur = con.cursor()
            cur.execute("SELECT PRODUCT_ID, PRODUCT_NAME, PRODUCT_PRICE, PRODUCT_QUANTITY FROM tbl_product")
            rows = cur.fetchall()

            if not rows:
                print("No products found.")
            else:
                print(f"{'ID':<5}{'Name':<25}{'Price':<12}{'Quantity':<10}")
                print("-" * 52)
                for row in rows:
                    print(f"{row[0]:<5}{row[1]:<25}P{row[2]:<11.2f}{row[3]:<10}")

            cur.close()
            con.close()
        except Error as error:
            print(f"Error retrieving products: {error}")

    # ---------------- PLACE ORDER ----------------
    elif choice == 5:
        print("\n--- Place an Order ---")

        try:
            con = mysql.connector.connect(host="localhost", database="db_jollibee", user="root", password="")
            cur = con.cursor()
            cur.execute("SELECT PRODUCT_ID, PRODUCT_NAME, PRODUCT_PRICE, PRODUCT_QUANTITY FROM tbl_product")
            rows = cur.fetchall()

            if not rows:
                print("No products available to order.")
            else:
                print(f"{'ID':<5}{'Name':<25}{'Price':<12}{'In Stock':<10}")
                print("-" * 52)
                for row in rows:
                    print(f"{row[0]:<5}{row[1]:<25}P{row[2]:<11.2f}{row[3]:<10}")

                product_id = None
                while product_id is None:
                    try:
                        product_id = int(input("\nEnter Product ID to order: ").strip())
                    except ValueError:
                        print("Error: Please enter a valid whole number.")

                cur.execute("SELECT PRODUCT_NAME, PRODUCT_PRICE, PRODUCT_QUANTITY FROM tbl_product WHERE PRODUCT_ID = %s", (product_id,))
                product = cur.fetchone()

                if product is None:
                    print("Error: No product found with that ID.")
                else:
                    prod_name, prod_price, prod_stock = product

                    order_qty = None
                    while order_qty is None:
                        try:
                            order_qty = int(input(f"Quantity to order (available: {prod_stock}): ").strip())
                            if order_qty <= 0:
                                print("Error: Quantity must be greater than 0.")
                                order_qty = None
                            elif order_qty > prod_stock:
                                print(f"Error: Only {prod_stock} in stock. Please enter a lower quantity.")
                                order_qty = None
                        except ValueError:
                            print("Error: Please enter a valid whole number.")

                    total_price = prod_price * order_qty
                    confirm = input(f"Order {order_qty}x {prod_name} for a total of P{total_price:.2f}? (y/n): ").strip().lower()

                    if confirm == "y":
                        cur.execute(
                            "INSERT INTO tbl_order (PRODUCT_ID, PRODUCT_NAME, QUANTITY, TOTAL_PRICE) VALUES (%s, %s, %s, %s)",
                            (product_id, prod_name, order_qty, total_price)
                        )
                        cur.execute(
                            "UPDATE tbl_product SET PRODUCT_QUANTITY = PRODUCT_QUANTITY - %s WHERE PRODUCT_ID = %s",
                            (order_qty, product_id)
                        )
                        con.commit()
                        print("Order successfully placed!")
                    else:
                        print("Order cancelled.")

            cur.close()
            con.close()
        except Error as error:
            print(f"Error placing order: {error}")

    # ---------------- DISPLAY ORDERS ----------------
    elif choice == 6:
        print("\n--- All Orders ---")
        try:
            con = mysql.connector.connect(host="localhost", database="db_jollibee", user="root", password="")
            cur = con.cursor()
            cur.execute("SELECT ORDER_ID, PRODUCT_NAME, QUANTITY, TOTAL_PRICE FROM tbl_order")
            rows = cur.fetchall()

            if not rows:
                print("No orders found.")
            else:
                print(f"{'Order ID':<10}{'Product':<25}{'Qty':<8}{'Total':<10}")
                print("-" * 53)
                for row in rows:
                    print(f"{row[0]:<10}{row[1]:<25}{row[2]:<8}P{row[3]:.2f}")

            cur.close()
            con.close()
        except Error as error:
            print(f"Error retrieving orders: {error}")

    # ---------------- EXIT ----------------
    elif choice == 7:
        print("Exiting Jollibee Product System. Goodbye!")
        break

    else:
        print("Error: Please enter a number between 1 and 7.")
